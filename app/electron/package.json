{
  "name": "vanguard-deck-lab",
  "productName": "Vanguard Deck Lab",
  "version": "1.0.0",
  "description": "Vanguard D Deck Lab - fan-made deck testing game",
  "main": "main.js",
  "author": "Voke",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright": "1.49.1"
  },
  "build": {
    "appId": "lab.vanguard.deck",
    "productName": "Vanguard Deck Lab",
    "files": [
      "main.js",
      "vg.ico",
      "updater.html",
      "game/**"
    ],
    "win": {
      "icon": "vg.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Vanguard Deck Lab",
      "artifactName": "VanguardDeckLab-Setup-${version}.exe",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "VanguardDeckLab-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AclAireZ",
        "repo": "vanguard-deck-lab",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
